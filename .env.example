# ─────────────────────────────────────────────────────────────
# Actitud Alfa 360 — variables de entorno
# En Hostinger: Web App → Settings → Environment variables.
# Nunca subas un .env real a GitHub.
# ─────────────────────────────────────────────────────────────

# staging | production   (staging = rama develop: noindex, contraseña, Stripe en modo test)
APP_ENV=staging
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_SITE_URL=https://staging.actitudalfa360.com
# Solo staging: protege el sitio con usuario:contraseña (dejar vacío en producción)
STAGING_BASIC_AUTH=

# Stripe — llave RESTRINGIDA (rk_test_ en staging, rk_live_ en producción) con permisos Write en:
#   Checkout Sessions · Products · Prices · Shipping Rates   (nada más)
STRIPE_SECRET_KEY=
# Webhook → https://<dominio>/api/webhooks/stripe
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# MySQL de Hostinger (obligatoria en producción)
DATABASE_URL=mysql://usuario:contraseña@localhost:3306/base
DB_POOL_SIZE=5

# Envío fijo por pedido (centavos)
SHIPPING_FLAT_CENTS=899

# Correo (SMTP de Hostinger, buzón hola@actitudalfa360.com)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hola@actitudalfa360.com
SMTP_PASSWORD=
MAIL_FROM=Actitud Alfa 360 <hola@actitudalfa360.com>
# A dónde te llega el aviso de cada venta
ORDER_NOTIFY_EMAIL=

# Printify: crear pedido EN ESPERA al recibir el pago (no se manda a producción solo)
PRINTIFY_AUTO_ORDER=false
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
