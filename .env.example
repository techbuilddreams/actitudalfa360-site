# ─────────────────────────────────────────────────────────────
# Actitud Alfa 360 — variables de entorno
# En Hostinger: Web App → Settings → Environment variables.
# Nunca subas un .env real a GitHub.
# ─────────────────────────────────────────────────────────────

# preview | production   (preview = develop: noindex + Stripe en modo test)
APP_ENV=preview
NEXT_PUBLIC_APP_ENV=preview
NEXT_PUBLIC_SITE_URL=https://preview.actitudalfa360.com

# Stripe — llave RESTRINGIDA (rk_test_ en preview, rk_live_ en producción) con permisos Write en:
#   Checkout Sessions · Products · Prices · Shipping Rates   (nada más)
STRIPE_SECRET_KEY=
# Webhook → https://<dominio>/api/webhooks/stripe
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# MySQL de Hostinger (obligatoria en producción)
DATABASE_URL=mysql://usuario:contraseña@localhost:3306/base

# Envío fijo por pedido (centavos)
SHIPPING_FLAT_CENTS=899

# Printify: crear pedido EN ESPERA al recibir el pago (no se manda a producción solo)
PRINTIFY_AUTO_ORDER=false
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
