# ───────────────────────────────────────────────────────────────
# Actitud Alfa 360 — variables de entorno
# Copia este archivo como  .env  en:  domains/actitudalfa360.com/.env
# (UN NIVEL ARRIBA de public_html; el servidor web no lo puede servir)
# Nunca subas el .env a GitHub.
# ───────────────────────────────────────────────────────────────

SITE_URL=https://actitudalfa360.com

# Stripe — usa una RESTRICTED key (rk_live_...) con estos permisos (nada más):
#   Checkout Sessions: Write · Products: Write · Prices: Write · Shipping Rates: Write
#   (Checkout crea producto/precio/envío en línea). Pruébala primero con rk_test_.
STRIPE_SECRET_KEY=
# Developers → Webhooks → endpoint https://actitudalfa360.com/api/webhook.php
# Eventos: checkout.session.completed y checkout.session.async_payment_succeeded  →  copia el "Signing secret" (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Envío fijo por pedido (centavos) y Stripe Tax
SHIPPING_CENTS=899
AUTOMATIC_TAX=false

# Printify — crea el pedido automáticamente al recibir el pago.
# El pedido queda EN ESPERA (no se manda a producción) hasta que lo apruebes.
PRINTIFY_AUTO_ORDER=false
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# Aviso por email de cada venta
ORDER_NOTIFY_EMAIL=
